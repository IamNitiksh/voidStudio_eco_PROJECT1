VITE_FIREBASE_KEY=from_firebase_key_here

VITE_AUTH_DOMAIN=from_firebase_auth_domain

VITE_PROJECT_ID=from_firebase_project_id

VITE_STORAGE_BUCKET=from_firebase_storage_bucket

VITE_MESSAGING_SENDER_ID=from_firebase_messaging_sender_id

VITE_APP_ID=from_firebase_app_id

# Backend server URL example (no quotes). Set to your backend address, e.g.: http://localhost:5000
VITE_SERVER=http://localhost:5000

# Stripe publishable key
VITE_STRIPE_KEY=your_stripe_publishable_key